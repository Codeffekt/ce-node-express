{
  "compilerOptions": {
    "outDir": "./dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2019",
    "module": "commonjs",
    "lib": [
      "es2019",
      "dom"
    ]
  },
  "include": ["./src/**/*"],
  "exclude": ["**/*.spec.ts", "./dist/**/*"]
}
